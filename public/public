:root {
  --bg: #f5f7fa;
  --fg: #0a2540;
  --muted: #6b7a90;
  --accent: #2f6fed;
  --card: #ffffff;
  --border: #e3e8f1;
}

* { box-sizing: border-box; }
html, body { height: 100%; }
body {
  margin: 0;
  font-family: "Segoe UI", Arial, sans-serif;
  background: var(--bg);
  color: var(--fg);
  line-height: 1.45;
  padding: 0 16px;
}

header, main, footer { max-width: 880px; margin: 20px auto; }
h1 { margin: 0 0 6px; font-size: 28px; }
.sub { margin: 0; color: var(--muted); }

main {
  background: var(--card);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 20px;
}

form { display: grid; gap: 14px; }
.block { display: grid; gap: 6px; font-weight: 600; }
input[type="file"], select {
  padding: 10px;
  border: 1px solid var(--border);
  border-radius: 6px;
  background: #fff;
}

button {
  width: fit-content;
  padding: 10px 18px;
  font-size: 15px;
  color: #fff;
  background: var(--accent);
  border: none;
  border-radius: 8px;
  cursor: pointer;
}
button:hover { filter: brightness(1.05); }

#status { margin-top: 8px; font-weight: 600; }
footer { text-align: center; color: var(--muted); }
